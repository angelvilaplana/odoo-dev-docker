#!/usr/bin/env bash

bin/docker-compose exec -u root odoo bash -c 'chown -R odoo:odoo /opt/odoo'
bin/docker-compose exec -u root odoo bash -c 'chown -R odoo:odoo /etc/odoo'
bin/docker-compose exec -u root odoo bash -c 'chown -R odoo:odoo /var/log'
bin/docker-compose exec -u root odoo bash -c 'chown -R odoo:odoo /var/lib/odoo'
bin/docker-compose exec -u root odoo bash -c 'chown -R odoo:odoo /mnt/extra-addons'
bin/docker-compose exec -u root db   bash -c 'chown -R postgres:postgres /var/lib/postgresql'

sudo chown -R $(id -u):$(id -g) odoo
sudo chown -R $(id -u):$(id -g) postgresql
