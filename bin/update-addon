#!/bin/bash

source env/odoo.env

DB_NAME=$1
ADDON=$2

bin/cliodoo /opt/odoo/odoo/odoo-bin -d ${DB_NAME} -u ${ADDON} \
    --xmlrpc-port 8001 \
    --db_port 5432 \
    --db_host ${HOST} \
    --db_user ${USER} \
    --db_password ${PASSWORD} \
    --stop-after-init \
    --i18n-overwrite \
    --logfile= \
    --workers=0
