#!/bin/bash

source env/odoo.env

DB_NAME=$1
TEST_TAGS=$2

bin/cliodoo /opt/odoo/odoo/odoo-bin \
    -d ${DB_NAME}
    --test-enable \
    --test-enable \
    --test-tags=$2 \
    --xmlrpc-port 8001 \
    --db_port 5432 \
    --db_host ${HOST} \
    --db_user ${USER} \
    --db_password ${PASSWORD} \
    --logfile= \
    --stop-after-init
